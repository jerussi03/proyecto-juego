; Shared KOF-inspired system. var(40)=MAX frames, var(41)=entry cost.

[Statedef 920]
type = S
movetype = I
physics = N
anim = 920
ctrl = 0
velset = 0,0
poweradd = 0

[State 920, Invulnerable to strikes and projectiles, throwable]
type = NotHitBy
trigger1 = Time >= 2 && Time < 16
value = SCA, AA, AP
time = 1

[State 920, Travel]
type = VelSet
trigger1 = Time < 16
x = 5.5

[State 920, Vulnerable recovery]
type = VelSet
trigger1 = Time >= 16
x = 0

[State 920, Pass opponent]
type = PlayerPush
trigger1 = Time < 16
value = 0

[State 920, Trail]
type = AfterImage
trigger1 = Time = 0
time = 16
length = 5
timegap = 2
framegap = 1
trans = add
palcolor = 0
paladd = 0,35,65

[State 920, Finish]
type = ChangeState
trigger1 = Time >= 24
value = 0
ctrl = 1

