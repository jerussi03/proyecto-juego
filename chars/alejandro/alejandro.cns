; BEGIN TEACHER SPECIALS

[State -2, Teacher timer]
type = VarAdd
trigger1 = !IsHelper && var(46) > 0
v = 46
value = -1
ignorehitpause = 1

[State -2, Teacher timer]
type = VarAdd
trigger1 = !IsHelper && var(48) > 0
v = 48
value = -1
ignorehitpause = 1

[State -2, Reset temporary armor]
type = DefenceMulSet
trigger1 = !IsHelper
value = 1

[State -2, New action resource latch]
type = VarSet
trigger1 = !IsHelper && Time = 0
v = 50
value = 0

[State -2, Preparation expires]
type = VarSet
trigger1 = !IsHelper && var(46)=1
v = 44
value = 0

