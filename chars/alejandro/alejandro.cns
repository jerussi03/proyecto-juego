; The controller calls an AI tutor. Cost is charged exactly once on entry.

[Statedef -2]

; BEGIN TEACHER SPECIALS

[State -2, Teacher timer]
type = VarAdd
trigger1 = !IsHelper && var(46) > 0
v = 46
value = -1
ignorehitpause = 1

[State -2, Teacher timer]
type = VarAdd
trigger1 = !IsHelper && var(48) > 0
v = 48
value = -1
ignorehitpause = 1

[State -2, Reset temporary armor]
type = DefenceMulSet
trigger1 = !IsHelper
value = 1

[State -2, New action resource latch]
type = VarSet
trigger1 = !IsHelper && Time = 0
v = 50
value = 0

[State -2, Preparation expires]
type = VarSet
trigger1 = !IsHelper && var(46)=1
v = 44
value = 0

[State -2, Identity resource indicator]
type = Explod
trigger1 = !IsHelper && RoundState=2 && var(44)>=1 && NumExplod(8891)=0
anim = 8790
ID = 8891
postype = left
pos = ifelse(TeamSide=1,35,250)+9,43
scale = .18,.18
bindtime = -1
removetime = 2
sprpriority = 7
ownpal = 1

[State -2, Identity resource indicator]
type = Explod
trigger1 = !IsHelper && RoundState=2 && var(44)>=2 && NumExplod(8892)=0
anim = 8790
ID = 8892
postype = left
pos = ifelse(TeamSide=1,35,250)+18,43
scale = .18,.18
bindtime = -1
removetime = 2
sprpriority = 7
ownpal = 1

[State -2, Identity resource indicator]
type = Explod
trigger1 = !IsHelper && RoundState=2 && var(44)>=3 && NumExplod(8893)=0
anim = 8790
ID = 8893
postype = left
pos = ifelse(TeamSide=1,35,250)+27,43
scale = .18,.18
bindtime = -1
removetime = 2
sprpriority = 7
ownpal = 1
; END TEACHER SPECIALS

