; Definition file for ALEX — EL ALUMNO PROMEDIO
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Alex"              ;Name of character
displayname = "ALEX — EL ALUMNO PROMEDIO" ;Name of character to display
versiondate = 09,05,2026   ;Version date of character (MM-DD-YYYY or X.XX)
mugenversion = 1.0         ;Version of M.U.G.E.N character works on (X.XX)
author = "Proyecto Universidad" ;Character author name
pal.defaults = 1,2,3,4     ;Default palettes in order of preference (up to 4)
localcoord = 320,240       ;Local coordinate space width and height

; Files for the player
[Files]
cmd     = kfm.cmd          ;Command set
cns     = kfm.cns          ;Constants
st      = kfm.cns          ;States
stcommon = common1.cns     ;Common states (from data/ or motif)
sprite  = estudiante.sff   ;Sprite
anim    = estudiante.air   ;Animation
sound   = kfm.snd          ;Sound
ai      = kfm.ai           ;AI hints data (not used)
movelist = movelist.dat    ;Ikemen feature: Movelist

; Maps character selection buttons to palette numbers.
[Palette Keymap]
x = 1
y = 2
z = 3
a = 4
b = 5
c = 6
x2 = 7
y2 = 8
z2 = 9
a2 = 10
b2 = 11
c2 = 12

; Arcade mode
[Arcade]
intro.storyboard = intro.def
ending.storyboard = ending.def
