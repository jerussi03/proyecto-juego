; Active frame is element 4 in chava.air, including on whiff.
[Statedef 200]
type = S
movetype = A
physics = S
ctrl = 0
anim = ifelse(var(20), 201, 200)
velset = 0,0
juggle = 1
poweradd = 12
sprpriority = 2

[State 200, Alternate next attack]
type = VarSet
trigger1 = Time = 0
v = 20
value = 1 - var(20)

[State 200, Clear repeat buffer]
type = VarSet
trigger1 = Time = 0
v = 24
value = 0

[State 200, Swing]
type = PlaySnd
trigger1 = AnimElem = 3
value = 0,0

[State 200, Contact]
type = HitDef
trigger1 = AnimElem = 4
attr = S, NA
damage = 28,0
animtype = Light
guardflag = MA
hitflag = MAF
priority = 3,Hit
pausetime = 6,7
sparkno = 0
sparkxy = -7,-68
hitsound = 5,0
guardsound = 6,0
ground.type = High
ground.slidetime = 8
ground.hittime = 12
ground.velocity = -3.2
air.velocity = -3,-4.5
air.hittime = 18
fall = 0
fall.recover = 1

[State 200, Buffer another press]
type = VarSet
triggerall = AILevel = 0
triggerall = Time >= 3
trigger1 = command = "x"
v = 24
value = 1
ignorehitpause = 1

[State 200, Play buffered alternate]
type = ChangeState
trigger1 = var(24) = 1
trigger1 = AnimElemTime(5) >= 0
value = 200
ctrl = 0

[State 200, End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


