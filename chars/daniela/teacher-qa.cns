; The controller calls an AI tutor. Cost is charged exactly once on entry.
[Statedef -2]

; Isolated real-input QA. Never loaded by production definitions.

[State -2, Clock]
type = VarAdd
trigger1 = RoundState = 2
v = 58
value = 1
ignorehitpause = 1

