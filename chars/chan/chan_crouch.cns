; Chan crouch override (state 11).
; Adds the ability to move while crouched using the crouch-walk animations.
; Loaded via st1 in chan.def so it overrides the common crouching state.

[Statedef 11]
type = C
physics = C
anim = 11
sprpriority = 0

[State 11, Walk Fwd Vel]
type = VelSet
trigger1 = command = "holdfwd"
x = 1.0

[State 11, Walk Back Vel]
type = VelSet
trigger1 = command = "holdback"
x = -0.8

[State 11, Stop Vel]
type = VelSet
triggerall = !command = "holdfwd"
triggerall = !command = "holdback"
trigger1 = 1
x = 0

[State 11, Walk Fwd Anim]
type = ChangeAnim
triggerall = command = "holdfwd"
trigger1 = anim != 8
value = 8

[State 11, Walk Back Anim]
type = ChangeAnim
triggerall = command = "holdback"
trigger1 = anim != 9
value = 9

[State 11, Idle Anim]
type = ChangeAnim
triggerall = !command = "holdfwd"
triggerall = !command = "holdback"
trigger1 = anim != 11
value = 11

;---------------------------------------------------------------------------
; Mongo punch
[Statedef 220]
type = S
movetype = A
physics = S
juggle = 4
poweradd = 30
ctrl = 0
velset = 0,0
anim = 220
sprpriority = 2

[State 220, Hit]
type = HitDef
trigger1 = AnimElem = 30
attr = S, NA
animtype = Medium
damage = 65, 0
guardflag = MA
hitflag = MAF
priority = 4, Hit
pausetime = 12, 12
sparkno = 1
sparkxy = 35, -55
hitsound = 5, 2
guardsound = 6, 0
ground.type = High
ground.slidetime = 12
ground.hittime = 16
ground.velocity = -5.5
air.velocity = -2.5, -4
forcenofall = 1

[State 220, End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[State -1, Mongo punch]
type = ChangeState
value = 220
triggerall = command = "c"
triggerall = statetype = S
trigger1 = ctrl